# Copy to .env or just export these before running. Only ANTHROPIC_API_KEY is
# required — everything else is optional and degrades gracefully.

ANTHROPIC_API_KEY=sk-ant-...

# --- model overrides -------------------------------------------------------
# ECHO_MODEL=claude-sonnet-4-6        # day-to-day chat / argue / asme / decide
# ECHO_SYNTH_MODEL=claude-opus-4-8    # deep dossier synthesis

# --- premium voice (optional) ----------------------------------------------
# Without these, Echo uses the browser's built-in voice.
# ELEVENLABS_API_KEY=...              # text-to-speech (natural voice)
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_turbo_v2_5
# OPENAI_API_KEY=sk-...              # Whisper speech-to-text

# --- email reminders (optional) --------------------------------------------
# Without these, Echo prompts you on-open instead of emailing.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# ECHO_EMAIL_TO=you@gmail.com
# ECHO_EMAIL_FROM=you@gmail.com       # defaults to SMTP_USER
# ECHO_REMINDER_INTERVAL=3600         # seconds between checks
