[configuration]

entry_symbol = "bb_native_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin/libbbnative.linux.template_release.x86_64.so"
linux.release.x86_64 = "res://bin/libbbnative.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libbbnative.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://bin/libbbnative.windows.template_release.x86_64.dll"
