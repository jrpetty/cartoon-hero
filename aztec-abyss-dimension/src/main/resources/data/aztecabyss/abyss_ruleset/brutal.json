  "script": [
    {
      "on": "run_start",
      "do": [
        {
          "title": {
            "main": "\u00a74NO LAST ROUND",
            "sub": "Leave while you still can"
          }
        }
      ]
    },
    {
      "on": "round_start",
      "when": {
        "round": {
          "every": 10
        }
      },
      "do": [
        {
          "title": {
            "main": "\u00a74\u00a7lSOMETHING ELSE"
          }
        },
        {
          "sound": {
            "id": "minecraft:entity.warden_emerge",
            "pitch": 0.8
          }
        },
        {
          "spawn": {
            "id": "minecraft:ravager",
            "at": "boss",
            "health": 220
          }
        }
      ]
    },
    {
      "on": "round_start",
      "when": {
        "round": {
          "at_least": 25
        }
      },
      "do": [
        {
          "effect": {
            "id": "minecraft:darkness",
            "seconds": 6
          }
        }
      ]
    },
    {
      "on": "round_end",
      "when": {
        "round": {
          "every": 5
        }
      },
      "do": [
        {
          "award": {
            "amount": 250
          }
        },
        {
          "actionbar": "\u00a77The dark pays you to keep going."
        }
      ]
    },
    {
      "on": "extracted",
      "do": [
        {
          "title": {
            "main": "\u00a76BANKED",
            "sub": "You chose the moment"
          }
        },
        {
          "give": {
            "id": "minecraft:diamond",
            "count": 6
          }
        },
        {
          "give": {
            "id": "minecraft:gold_ingot",
            "count": 16
          }
        },
        {
          "sound": {
            "id": "minecraft:block.beacon.activate"
          }
        }
      ]
    }
  ]
