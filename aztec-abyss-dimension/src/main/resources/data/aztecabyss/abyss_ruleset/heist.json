{
  "rounds": { "mode": "free" },
  "economy": { "enabled": true, "currency": "points", "kill": 0 },
  "script": [
    { "on": "run_start",
      "do": [ { "title": { "main": "§6§lTHE HEIST", "sub": "Three idols. One way out." } },
              { "set_bar": "§60 of 3 idols" },
              { "set_var": { "name": "idols", "to": 0 } } ] },

    { "on": "region_enter", "when": { "region": "idol" },
      "do": [ { "add_var": { "name": "idols", "by": 1 } },
              { "sound": "minecraft:block.beacon.activate" },
              { "actionbar": "§6You have it. Get out." } ] },

    { "on": "tick", "when": { "var": { "name": "idols", "equals": 1 } },
      "do": [ { "set_bar": "§61 of 3 idols" } ] },
    { "on": "tick", "when": { "var": { "name": "idols", "equals": 2 } },
      "do": [ { "set_bar": "§62 of 3 idols" } ] },
    { "on": "tick", "when": { "var": { "name": "idols", "at_least": 3 } },
      "do": [ { "set_bar": "§a3 of 3 — run" } ] },

    { "on": "region_enter",
      "when": { "region": "exit", "var": { "name": "idols", "at_least": 3 } },
      "do": [ { "win": { "title": "§6§lOUT WITH ALL THREE" } } ] },

    { "on": "tick", "when": { "seconds": { "at_least": 300 } },
      "do": [ { "lose": { "title": "§4§lTOO SLOW" } } ] }
  ]
}
