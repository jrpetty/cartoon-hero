{
  "title": "The Heist",
  "blurb": "Three idols, one way out, five minutes. Nothing spawns that the map does not send.",
  "rounds": {
    "mode": "free"
  },
  "economy": {
    "enabled": true,
    "currency": "points",
    "kill": 0
  },
  "script": [
    {
      "on": "run_start",
      "do": [
        {
          "title": {
            "main": "\u00a76\u00a7lTHE HEIST",
            "sub": "Three idols. One way out."
          }
        },
        {
          "set_bar": "\u00a760 of 3 idols"
        },
        {
          "set_var": {
            "name": "idols",
            "to": 0
          }
        }
      ]
    },
    {
      "on": "region_enter",
      "when": {
        "region": "idol"
      },
      "do": [
        {
          "add_var": {
            "name": "idols",
            "by": 1
          }
        },
        {
          "sound": "minecraft:block.beacon.activate"
        },
        {
          "actionbar": "\u00a76You have it. Get out."
        }
      ]
    },
    {
      "on": "tick",
      "when": {
        "var": {
          "name": "idols",
          "equals": 1
        }
      },
      "do": [
        {
          "set_bar": "\u00a761 of 3 idols"
        }
      ]
    },
    {
      "on": "tick",
      "when": {
        "var": {
          "name": "idols",
          "equals": 2
        }
      },
      "do": [
        {
          "set_bar": "\u00a762 of 3 idols"
        }
      ]
    },
    {
      "on": "tick",
      "when": {
        "var": {
          "name": "idols",
          "at_least": 3
        }
      },
      "do": [
        {
          "set_bar": "\u00a7a3 of 3 \u2014 run"
        }
      ]
    },
    {
      "on": "region_enter",
      "when": {
        "region": "exit",
        "var": {
          "name": "idols",
          "at_least": 3
        }
      },
      "do": [
        {
          "win": {
            "title": "\u00a76\u00a7lOUT WITH ALL THREE"
          }
        }
      ]
    },
    {
      "on": "tick",
      "when": {
        "seconds": {
          "at_least": 300
        }
      },
      "do": [
        {
          "lose": {
            "title": "\u00a74\u00a7lTOO SLOW"
          }
        }
      ]
    }
  ]
}
