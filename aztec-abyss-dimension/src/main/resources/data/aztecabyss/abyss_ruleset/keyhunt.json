{
  "mode": "free",
  "display": "The Key Hunt",
  "respawn": true,
  "script": [
    {
      "on": "player_joined",
      "when": {
        "my_saved_var": {
          "name": "escapes",
          "at_least": 1
        }
      },
      "do": [
        {
          "give": {
            "id": "minecraft:golden_apple",
            "count": 1
          }
        },
        {
          "actionbar": "\u00a76You have been here before. \u00a77{my_saved_var:escapes} escapes."
        }
      ]
    },
    {
      "on": "run_start",
      "when": {
        "saved_var": {
          "name": "cracked",
          "at_least": 1
        }
      },
      "do": [
        {
          "message": "\u00a78Somebody has cracked this before. \u00a77The north door is already open."
        },
        {
          "open_area": "north"
        }
      ]
    },
    {
      "on": "phase_start",
      "when": {
        "phase": "countdown"
      },
      "do": [
        {
          "message": "\u00a77The doors are about to open. \u00a7f{players}\u00a77 of you."
        }
      ]
    },
    {
      "on": "phase_start",
      "when": {
        "phase": "active"
      },
      "do": [
        {
          "teleport": {
            "region": "start_line"
          }
        },
        {
          "title": {
            "main": "\u00a76GO",
            "sub": "\u00a77{players} in the hunt"
          }
        }
      ]
    },
    {
      "on": "run_start",
      "do": [
        {
          "title": {
            "main": "\u00a76THE KEY HUNT",
            "sub": "\u00a77Three keys. One vault. Nothing hands them to you."
          }
        },
        {
          "set_var": {
            "name": "keys",
            "value": 0
          }
        }
      ]
    },
    {
      "on": "tick",
      "do": [
        {
          "set_bar": "\u00a76Keys \u00a7f{var:keys}\u00a77/3 \u00a78| \u00a77{time} \u00a78| \u00a77{players} in"
        }
      ]
    },
    {
      "on": "mob_killed",
      "when": {
        "killed": "husk"
      },
      "do": [
        {
          "give": {
            "id": "minecraft:tripwire_hook",
            "count": 1
          }
        },
        {
          "actionbar": "\u00a7eA key. \u00a77Take it to the vault door."
        }
      ]
    },
    {
      "on": "mob_killed",
      "when": {
        "killed": "zombie",
        "chance": 8
      },
      "do": [
        {
          "give": {
            "id": "minecraft:tripwire_hook",
            "count": 1
          }
        },
        {
          "actionbar": "\u00a7eSomething fell out of it."
        }
      ]
    },
    {
      "on": "use_block",
      "when": {
        "region": "vault_door",
        "has_item": {
          "id": "minecraft:tripwire_hook",
          "count": 1
        }
      },
      "do": [
        {
          "take": {
            "id": "minecraft:tripwire_hook",
            "count": 1
          }
        },
        {
          "add_var": {
            "name": "keys",
            "value": 1
          }
        },
        {
          "sound": "minecraft:block.beacon.activate"
        },
        {
          "message": "\u00a7aA lock turns."
        },
        {
          "set_bar": "\u00a76Keys \u00a7f{var:keys}\u00a77/3 \u00a78| \u00a77{time}"
        }
      ]
    },
    {
      "on": "use_block",
      "when": {
        "region": "vault_door"
      },
      "do": [
        {
          "actionbar": "\u00a77Locked. \u00a78It wants a key."
        }
      ]
    },
    {
      "on": "tick",
      "when": {
        "var": {
          "name": "keys",
          "at_least": 3
        }
      },
      "do": [
        {
          "open_area": "vault"
        },
        {
          "teleport": {
            "region": "vault"
          }
        },
        {
          "heal": {}
        },
        {
          "title": {
            "main": "\u00a76THE VAULT IS OPEN"
          }
        },
        {
          "win": {
            "message": "\u00a76The Glade cracked it."
          }
        },
        {
          "add_saved_var": {
            "name": "cracked",
            "value": 1
          }
        },
        {
          "add_my_saved_var": {
            "name": "escapes",
            "value": 1
          }
        },
        {
          "message": "\u00a77The vault has been cracked \u00a7f{saved_var:cracked}\u00a77 times. You: \u00a7f{my_saved_var:escapes}\u00a77."
        }
      ]
    }
  ],
  "lobby": {
    "min_players": 1,
    "countdown_seconds": 15,
    "wait_seconds": 60
  }
}