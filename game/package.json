{
  "name": "banner-and-blade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Banner & Blade \u2014 a stylized-fantasy real-time strategy game with skirmish AI and a CS-style unit collection meta.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:single": "node scripts/inline.mjs && node scripts/boot-check.mjs",
    "serve": "node server/server.mjs",
    "assets:meshy": "tsx scripts/meshy.ts",
    "perf": "tsx scripts/perf.ts"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
